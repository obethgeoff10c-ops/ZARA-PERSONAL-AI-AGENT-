# Local development only. Copy to .env and replace the placeholders.
# Never commit .env.
POSTGRES_DB=zara
POSTGRES_USER=zara
POSTGRES_PASSWORD=replace-me

# Host-side URL for running the API outside Docker (uv run ...).
DATABASE_URL=postgresql+asyncpg://zara:replace-me@localhost:5432/zara
REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,api,web

# Browser-visible API origin and the in-container/server-side origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000
