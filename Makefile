SHELL := /bin/bash
.DEFAULT_GOAL := help
COMPOSE ?= docker compose

.PHONY: help bootstrap env api-install web-install up up-fg down logs ps migrate migration db-shell api-shell api-types api-lint api-format api-typecheck api-test api-test-all web-lint web-typecheck web-test web-build api-check web-check check verify compose-config clean

help: ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-16s\033[0m %s\n", $$1, $$2}'

bootstrap: env api-install web-install ## Install host dependencies and create .env

env: ## Create .env from .env.example when missing
	@test -f .env || (cp .env.example .env && echo "created .env (local defaults only)")

api-install: ## Sync Python dependencies with uv
	cd services/core && uv sync --frozen

web-install: ## Install Node dependencies from the lockfile
	npm ci

up: ## Start the full stack in the background
	$(COMPOSE) up --build -d

up-fg: ## Start the full stack in the foreground
	$(COMPOSE) up --build

down: ## Stop the stack (keeps volumes)
	$(COMPOSE) down

logs: ## Follow service logs
	$(COMPOSE) logs -f --tail=100

ps: ## Show service status and health
	$(COMPOSE) ps

migrate: ## Apply migrations inside the API container
	$(COMPOSE) exec api alembic upgrade head

migration: ## Create an autogenerated revision: make migration name=add_table
	@test -n "$(name)" || (echo "usage: make migration name=add_table" && exit 1)
	$(COMPOSE) exec api alembic revision --autogenerate -m "$(name)"

db-shell: ## Open psql
	$(COMPOSE) exec postgres psql -U $${POSTGRES_USER:-zara} -d $${POSTGRES_DB:-zara}

api-shell: ## Open a shell in the API container
	$(COMPOSE) exec api sh

api-types: ## Regenerate the OpenAPI document and TypeScript client
	cd services/core && uv run python scripts/export_openapi.py ../../packages/api-client/openapi.json
	npm run api:types

api-lint: ## Ruff lint and format check
	cd services/core && uv run ruff check . && uv run ruff format --check .

api-format: ## Apply Ruff formatting
	cd services/core && uv run ruff check --fix . && uv run ruff format .

api-typecheck: ## Strict mypy on the application package
	cd services/core && uv run mypy zara

api-test: ## Run backend tests (integration tests skip without ZARA_INTEGRATION=1)
	cd services/core && uv run pytest

api-test-all: ## Run unit + integration tests against host services
	cd services/core && ZARA_INTEGRATION=1 uv run pytest

web-lint: ## ESLint and api-client type check
	npm run lint

web-typecheck: ## TypeScript across both workspaces
	npm run typecheck

web-test: ## Vitest
	npm test

web-build: ## Production Next.js build
	npm run build

api-check: api-lint api-typecheck api-test ## Backend quality gate

web-check: web-lint web-typecheck web-test web-build ## Frontend quality gate

check: api-check web-check ## Everything that runs without Docker

verify: check compose-config ## Pre-push verification

compose-config: ## Validate docker-compose.yml
	$(COMPOSE) config -q

clean: ## Remove local caches (never database volumes)
	rm -rf apps/web/.next apps/web/coverage services/core/.pytest_cache services/core/.mypy_cache services/core/.ruff_cache
	find . -type d -name __pycache__ -prune -exec rm -rf {} +
